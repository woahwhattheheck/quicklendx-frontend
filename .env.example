# Sentry DSN for error tracking. When empty or unset, Sentry is disabled.
# Format: https://<key>@<org>.ingest.sentry.io/<project>
SENTRY_DSN=

# Which Stellar network the client targets: "testnet" or "mainnet".
# Unset or unrecognized values fall back to "testnet".
STELLAR_NETWORK=

# Feature flags -- see lib/featureFlags.ts. Set to exactly "true" to enable;
# unset, empty, or any other value is disabled.
NEXT_PUBLIC_FEATURE_NEW_DASHBOARD_LAYOUT=

# Milliseconds before a toast auto-dismisses. Unset, non-numeric, or
# non-positive values fall back to the 5000ms default.
NEXT_PUBLIC_TOAST_AUTO_DISMISS_MS=
